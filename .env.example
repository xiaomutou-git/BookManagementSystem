# 图书管理系统环境变量模板（.env 已被 .gitignore 排除）
# 生产必填：随机密钥。生成：python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=请替换为随机密钥
# 生产必填：关闭调试
DJANGO_DEBUG=False
# 生产必填：允许访问的主机（逗号分隔）
DJANGO_ALLOWED_HOSTS=example.com
# 允许跨域的前端来源（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:8000
